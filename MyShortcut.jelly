import Shortcuts
// ShortcutsVersion: 1092.6
#Color: green
#Icon: shortcuts

const NOTION_TOKEN = "secret_XXXXX" // your integration token
const DATABASE_ID = "XXXXX" // your database ID

const queryResp = await Shortcuts.networkRequest({
    url: `https://api.notion.com/v1/databases/${DATABASE_ID}/query`,
    method: "POST",
    headers: {
        "Authorization": `Bearer ${NOTION_TOKEN}`,
        "Content-Type": "application/json",
        "Notion-Version": "2022-06-28"
    },
    body: {
        filter: {
            property: "Done",
            checkbox: { equals: false }
        }
    },
    outputType: "Dictionary"
})

const pages = queryResp.results.map(p => ({
    id: p.id,
    name: p.properties.Name.title[0].plain_text
}))

if (pages.length === 0) {
    Shortcuts.alert("No unchecked pages found.")
    Shortcuts.exit()
}

const choices = pages.map(p => p.name)
const pickedName = await Shortcuts.prompt("Pick a page to mark done:", choices)
const picked = pages.find(p => p.name === pickedName)

await Shortcuts.networkRequest({
    url: `https://api.notion.com/v1/pages/${picked.id}`,
    method: "PATCH",
    headers: {
        "Authorization": `Bearer ${NOTION_TOKEN}`,
        "Content-Type": "application/json",
        "Notion-Version": "2022-06-28"
    },
    body: {
        properties: {
            Done: { checkbox: true }
        }
    }
})

Shortcuts.alert(`Marked "${picked.name}" as done!`)
