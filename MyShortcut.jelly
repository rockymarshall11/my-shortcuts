import Shortcuts 1092.6
#Color: green
#Icon: shortcuts

(async () => {
  // Notion integration token
  const NOTION_TOKEN = "secret_XXXXX"
  // Notion database ID
  const DATABASE_ID = "XXXXX"

  // 1) Query Notion for pages where Done = false
  const queryResp = await Shortcuts.networkRequest({
    url: `https://api.notion.com/v1/databases/${DATABASE_ID}/query`,
    method: "POST",
    headers: {
      "Authorization": `Bearer ${NOTION_TOKEN}`,
      "Content-Type": "application/json",
      "Notion-Version": "2022-06-28"
    },
    body: {
      filter: {
        property: "Done",
        checkbox: { equals: false }
      }
    },
    outputType: "Dictionary"
  })

  // 2) Build a list of titles
  const pages = queryResp.results.map(p => ({
    id: p.id,
    name: p.properties.Name.title[0].plain_text
  }))

  if (pages.length === 0) {
    await Shortcuts.alert("No unchecked pages found.")
    return
  }

  // 3) Show the list and pick one
  const pickedName = await Shortcuts.chooseFromList({
    list:   pages.map(p => p.name),
    prompt: "Pick a page to mark done"
  })
  if (!pickedName) return

  const picked = pages.find(p => p.name === pickedName)

  // 4) Mark it done
  await Shortcuts.networkRequest({
    url: `https://api.notion.com/v1/pages/${picked.id}`,
    method: "PATCH",
    headers: {
      "Authorization": `Bearer ${NOTION_TOKEN}`,
      "Content-Type": "application/json",
      "Notion-Version": "2022-06-28"
    },
    body: {
      properties: {
        Done: { checkbox: true }
      }
    }
  })

  // 5) Confirm and finish
  await Shortcuts.alert(`✔️ Marked "${picked.name}" as done!`)
})()
